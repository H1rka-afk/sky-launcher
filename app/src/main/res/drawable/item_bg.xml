<?xml version="1.0" encoding="utf-8"?>
<!-- Подсветка выбранной плитки при навигации пультом -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape><solid android:color="#40FFFFFF"/><corners android:radius="14dp"/>
            <stroke android:width="3dp" android:color="#FFFFFF"/></shape>
    </item>
    <item android:state_pressed="true">
        <shape><solid android:color="#60FFFFFF"/><corners android:radius="14dp"/></shape>
    </item>
    <item>
        <shape><solid android:color="#1AFFFFFF"/><corners android:radius="14dp"/></shape>
    </item>
</selector>
